# The local camera, picker, editor, and photo-library tour needs no credentials.
# These are optional Firebase Web SDK settings for a future cloud-storage extension.
# EXPO_PUBLIC_* values are shipped inside the client app; they are not secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
